<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">PayVector Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <field
                    name="payvector_merchant_id"
                    string="Merchant ID"
                    invisible="code != 'payvector'"
                    required="code == 'payvector' and is_live"
                    widget="password"
                />
                <field
                    name="payvector_password"
                    string="Password"
                    invisible="code != 'payvector'"
                    required="code == 'payvector' and is_live"
                    widget="password"
                />
                <field
                    name="payvector_integration_mode"
                    string="Integration Mode"
                    invisible="code != 'payvector'"
                    required="code == 'payvector'"
                    widget="radio"
                />
                <field
                    name="payvector_pre_shared_key"
                    string="Pre-Shared Key"
                    invisible="code != 'payvector' or payvector_integration_mode != 'hosted'"
                    required="code == 'payvector' and payvector_integration_mode == 'hosted' and is_live"
                    widget="password"
                />
                <field
                    name="payvector_hash_method"
                    string="Hash Method"
                    invisible="code != 'payvector' or payvector_integration_mode != 'hosted'"
                    widget="radio"
                />
                <field
                    name="payvector_result_delivery"
                    string="Result Delivery"
                    invisible="code != 'payvector' or payvector_integration_mode != 'hosted'"
                    widget="radio"
                />
                <field
                    name="payvector_show_saved_cards"
                    string="Saved Cards"
                    invisible="code != 'payvector'"
                    help="Do you want to show saved cards on front end?"
                />
            </group>
        </field>
    </record>

</odoo>
